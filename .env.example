# --- Market data ---
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets
POLYGON_API_KEY=

# --- Brokerage (Robinhood agentic MCP) ---
ROBINHOOD_TOKEN=

# --- LLM ---
ANTHROPIC_API_KEY=

# --- TradeForge runtime ---
TRADEFORGE_ENV=paper                 # paper | live
TRADEFORGE_STRATEGY_STATUS=PAPER     # PAPER | LIVE  (live-order hook requires LIVE)
TRADEFORGE_RISK_TOKEN=               # risk-approval token; required for any live order
TRADEFORGE_LIVE_CONFIRM=0            # 1 to enable interactive live confirmation
TRADEFORGE_RI=5                      # starting risk index (floor; band 5-8)
TRADEFORGE_BUYING_POWER=             # optional override for live buying-power checks
