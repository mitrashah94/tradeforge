<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TradeForge nightly data refresh (launchd / macOS).

  Runs scripts/refresh_data.sh every night at 02:30 local time — after the US
  market close + overnight data settle — to incrementally ingest recent bars
  and rebuild levels.

  Install (copy or symlink this file into ~/Library/LaunchAgents first):
    launchctl load -w ~/Library/LaunchAgents/com.tradeforge.nightly.plist  (symlink or copy this file there first)

  Uninstall:
    launchctl unload -w ~/Library/LaunchAgents/com.tradeforge.nightly.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tradeforge.nightly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd /Users/mitrashah/DayTrading/tradeforge &amp;&amp; exec scripts/refresh_data.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mitrashah/DayTrading/tradeforge</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/mitrashah/DayTrading/tradeforge/journal/nightly.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/mitrashah/DayTrading/tradeforge/journal/nightly.err.log</string>
</dict>
</plist>
